# ════════════════════════════════════════════════════════════════════════════
# VAHDAM Mailer Studio — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
# Copy to `.env.local` for local `vercel dev` use, OR add in Vercel dashboard
# under Settings → Environment Variables for Production / Preview / Development.
#
# NEVER commit a populated `.env.local` — it's already in `.gitignore`.
# This `.env.example` IS committed (no real values, just placeholders).
#
# TEXT PROVIDER CASCADE (tier-ordered, see api/_shared/llm.js):
#   Anthropic → OpenAI → Gemini → Grok/xAI → Groq → Cerebras
# Configure as many as you have — the cascade skips missing keys.
# ════════════════════════════════════════════════════════════════════════════

# ─── MODEL TIER DIAL (premium / standard / fast) ──────────────────────────
# Per-call `tier` (or APP_AI_TIER default) picks the model chain:
#   premium  (legacy 'maxpower') = *_TEXT_MODEL_MAX  — hero copy, mailer_full,
#            ChaiGPT, smart-brain copy. Chain: claude-opus-4-8 → gpt-5.5 →
#            gemini-3.1-pro → grok-4.3 → free floor.
#            Also puts OpenAI gpt-image-2 FIRST in the image cascade.
#   standard (legacy 'budget', DEFAULT) = *_TEXT_MODEL — variants, briefs,
#            calendars. Chain: claude-sonnet-5 → gpt-5-mini → gemini-3.5-flash
#            → grok-4.1-fast → free floor.
#   fast     (new) = *_TEXT_MODEL_FAST — classification, tagging, scoring.
#            Chain: claude-haiku-4-5 → gpt-5-nano → gemini-2.5-flash (free)
#            → groq → cerebras (Grok skipped).
APP_AI_TIER=standard

# ─── OpenAI / ChatGPT (paid) ──────────────────────────────────────────────
# Get key:  https://platform.openai.com/api-keys
# Fund:     https://platform.openai.com/settings/organization/billing ($5 min)
# Rotate if quota hits → add OPENAI_API_KEY_2 and OPENAI_API_KEY_3 as backups
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TEXT_MODEL_MAX=gpt-5.5
OPENAI_TEXT_MODEL_FAST=gpt-5-nano
# Image model: gpt-image-2 is the default primary (best instruction-following).
# If your account/org doesn't have it yet, the cascade auto-demotes to
# gpt-image-1 on model-not-found — no need to change this unless you want to
# pin gpt-image-1 explicitly. Requires a verified org + image credits.
OPENAI_IMAGE_MODEL=gpt-image-2

# ─── Anthropic / Claude (paid) ────────────────────────────────────────────
# Get key:  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_MODEL_MAX=claude-opus-4-8
ANTHROPIC_TEXT_MODEL_FAST=claude-haiku-4-5

# ─── Google Gemini (FREE tier available) ──────────────────────────────────
# Get key:  https://aistudio.google.com/app/apikey (free, sign in with Google)
# Free floor: gemini-2.5-flash (fast tier). Video: the same key drives Veo 3.1
# (paid tier required for video + Imagen).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL_MAX=gemini-3.1-pro
GEMINI_TEXT_MODEL_FAST=gemini-2.5-flash

# ─── Grok / xAI ───────────────────────────────────────────────────────────
# Get key:  https://console.x.ai
XAI_API_KEY=
GROK_TEXT_MODEL=grok-4.1-fast
GROK_TEXT_MODEL_MAX=grok-4.3

# ─── Groq (FREE — 30 RPM, OpenAI-compatible) ──────────────────────────────
# Get key:  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ─── Cerebras (FREE — 30 RPM, ultra-fast, OpenAI-compatible) ──────────────
# Get key:  https://cloud.cerebras.ai
# Note: free tier caps output at 8K tokens; no response_format support.
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b

# ─── OpenRouter (gateway → Claude/GPT/Gemini/Llama, OpenAI-compatible) ─────
# Free-tier reaches gpt-4o/gpt-4o-mini/gemini-2.5-flash/llama; a small credit
# top-up (https://openrouter.ai/credits) unlocks Claude. Accepts either name.
# To route premium copy through Claude once funded:
#   OPENROUTER_TEXT_MODEL_MAX=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# ─── GitHub Models (FREE — GPT-4o/o-series/Llama/Mistral via a GitHub PAT) ─
# Get token: https://github.com/settings/tokens (fine-grained, "Models" scope).
# Reads GITHUB_MODELS_TOKEN, or falls back to a plain GITHUB_TOKEN.
GITHUB_MODELS_TOKEN=
GITHUB_TEXT_MODEL=gpt-4o-mini

# ─── Cloudflare Workers AI (FREE daily allowance — text + Flux images) ─────
# Needs BOTH the account id and an API token with "Workers AI" read.
# Token: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ─── VIDEO generation (api/_shared/video-core.js — all optional) ──────────
# Cascade: Veo 3.1 (GEMINI_API_KEY, paid tier) → Sora 2 (OPENAI_API_KEY;
# OpenAI video API sunsets 2026-09-24) → Higgsfield Cloud (~$0.10/s) →
# OpenMontage → Runway gen4_turbo (~$0.05/s). With NO keys,
# ?action=video-generate returns a { connected:false, would_request } stub
# (same pattern as Klaviyo). The mailer asset agent pins Higgsfield + OpenMontage
# first (lifecycle-OS video policy) via preferProviders.
HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=
# OpenMontage — bearer-auth REST; override the base if your endpoint differs.
OPENMONTAGE_API_KEY=
# OPENMONTAGE_BASE=https://api.openmontage.ai/v1
RUNWAY_API_KEY=

# ─── OPTIONAL — GIF conversion worker (text→GIF for email) ──
# The mailer asset agent derives email GIFs from a generated short clip, then
# converts that clip to an optimised GIF via a tiny ffmpeg worker:
#   POST { video_url, fps, width, max_seconds } → { gif_url }
# Unset ⇒ the agent ships the source clip URL and reports the GIF as pending.
GIF_CONVERT_URL=

# ─── OPTIONAL — Ideogram 3 (text-in-image banners; not wired by default) ──
# IDEOGRAM_API_KEY=

# ─── OPTIONAL — Klaviyo (lifecycle email/SMS — scaffolded until key set) ──
# KLAVIYO_API_KEY=
# KLAVIYO_PUBLIC_KEY=
# KLAVIYO_REVISION=

# ─── OPTIONAL — Supabase (cross-device dashboard storage) ─────────────────
# If unset, dashboard falls back to localStorage-only.
# Get from: https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY — server-only (bypasses RLS). Powers dashboard counts, Created Assets,
#   Brain persistence, KB. A stale key returns 401 in prod and silently degrades to the anon fallback.
#   Set in Vercel (Production+Preview+Development) only, never in any client bundle. Rotate per
#   docs/b2-b3-secrets-runbook.md. (SMART_BRAIN_SUPABASE_SERVICE_ROLE_KEY is an accepted alias.)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── MANAGEMENT-ONLY — domain + OAuth migration (never in Vercel runtime) ─
# Used by scripts/migrate-domains.* and scripts/migrate-oauth.* to keep Google
# sign-in working after a project moves to <slug>.anchit-tandon.com. These are
# local/CI credentials for management APIs — do NOT add them to the Vercel app.
#   SUPABASE_ACCESS_TOKEN  — sbp_... personal access token (supabase.com ->
#                            Account -> Access Tokens). Grants the Management API
#                            used to update the Auth redirect allowlist.
#   <SLUG>_SUPABASE_PROJECT_REF — per-project Supabase ref, slug uppercased with
#                            non-alphanumerics -> underscore, e.g.
#                            VAHDAM_LIFECYCLE_OS_SUPABASE_PROJECT_REF=abcdefgh.
#                            SUPABASE_PROJECT_REF is the fallback for the primary
#                            app. (Same convention as preflight-credentials.sh.)
#   GCP_PROJECT            — optional; GCP project for the Console link (else
#                            read from `gcloud config get-value project`).
#                            gcloud/API cannot edit a Web-app OAuth client, so
#                            adding the new JavaScript origin stays a Console step.
# SUPABASE_ACCESS_TOKEN=sbp_...
# VAHDAM_LIFECYCLE_OS_SUPABASE_PROJECT_REF=

# ─── Google Sheets auth — TWO modes (pick ONE) ───────────────────────────
#
# MODE A (PREFERRED — keyless, can't be "rotated to death"):
# Workload Identity Federation. Vercel mints a short-lived OIDC token per
# request; Google STS swaps it for a federated access token; we impersonate
# the SA via IAM Credentials. No key file anywhere. Full setup in
# docs/workload-identity-federation.md.
#
# Required:
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/vercel-pool/providers/vercel-provider
GCP_SERVICE_ACCOUNT_EMAIL=lifecycle-os-bot@vahdam-lifecycle-os.iam.gserviceaccount.com
# Also REQUIRED: enable "OIDC Tokens" in Vercel Project Settings → Environment
# Variables → OIDC Tokens. That injects VERCEL_OIDC_TOKEN automatically — do
# NOT set it manually here.

# MODE B (LEGACY — JSON key in env, what we used before WIF):
# Use only if WIF isn't set up yet. The code prefers Mode A when GCP_*
# vars are present, so it's safe to leave both populated during cutover.
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=hub-bot@vahdam-lifecycle-os.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Sheet target (used by BOTH modes)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Emails

# ─── INTERNAL — set by Vercel automatically; do NOT override ──────────────
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=...
# VERCEL_OIDC_TOKEN=...   (injected per-request when OIDC Tokens is enabled)

# ─── SOCIAL MEDIA OS — platform push tokens (Phase 2; ALL optional) ───────
# api/_shared/social-push-core.js mirrors each network's publish endpoint and
# returns { connected:false, would_request } stubs (Klaviyo pattern) until the
# token is set. Daily generation (?action=social-run-daily on /api/brain,
# cron 04:30 UTC via /api/cron/social) works fully WITHOUT any of these —
# posts persist with push_status=not_integrated_phase_2.
# Meta Graph API (Instagram feed/Reels/Stories + Facebook Page)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=
# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
# LinkedIn UGC Posts API (author = organization URN, e.g. urn:li:organization:123)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
# X (Twitter) API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# YouTube Data API v3 (Shorts upload — OAuth2 access token)
YOUTUBE_ACCESS_TOKEN=
# Threads API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ─── PAID ADS — read-only reporting APIs (ChaiGPT ad_insights; ALL optional) ──
# api/_shared/ad-insights-core.js fetches ad conversion/traffic/engagement from
# each platform's OWN reporting API and returns { connected:false, would_request }
# stubs (Klaviyo pattern) until keys are set — never a fabricated ad figure.
# REGION-AWARE: append _US / _UK for a market-specific ad account, e.g.
# META_AD_ACCOUNT_ID_US / META_AD_ACCOUNT_ID_UK; the generic var is the fallback.
# Meta Ads — Graph API Insights (reuses META_ACCESS_TOKEN above)
META_AD_ACCOUNT_ID=          # numeric id WITHOUT the "act_" prefix (+ optional _US / _UK)
# Google Ads — GAQL via searchStream (OAuth refresh-token flow)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=       # 10-digit id, dashes optional (+ optional _US / _UK)
GOOGLE_ADS_LOGIN_CUSTOMER_ID= # optional manager (MCC) id for the header
# TikTok Ads — Business API integrated report (reuses TIKTOK_ACCESS_TOKEN above)
TIKTOK_ADVERTISER_ID=         # (+ optional _US / _UK)

# ── Optional tail rungs for the text cascade (descending accuracy) ──
# Tried only AFTER Anthropic→OpenAI→Gemini→Grok→Groq→Cerebras, and only when set.
# Both are skipped cleanly (never attempted) unless configured.
OLLAMA_BASE_URL=            # e.g. http://localhost:11434  (self-hosted; enables the Ollama rung)
OLLAMA_API_KEY=             # optional; Ollama usually needs none
OLLAMA_TEXT_MODEL=llama3.3
OLLAMA_TEXT_MODEL_MAX=llama3.3
OLLAMA_TEXT_MODEL_FAST=llama3.2
SAKANA_BASE_URL=            # forward-looking; set base + key to enable the Sakana rung
SAKANA_API_KEY=
SAKANA_TEXT_MODEL=sakana-default

# ─── REVENUE / NUMBER MONITORING (email alerts) ──────────────────────────
# api/_shared/alerts-core.js — anomaly detection, 2-hour pulses, EOD forecast.
# Scheduled by .github/workflows/alerts.yml, delivered by email. Guarded by
# CRON_SECRET (same value as the daily loop). ALL optional — with no RESEND key
# the endpoints still run and return a { sent:false, would_send } stub (never
# fabricate, never spam).
#
# Shared cron secret — protects ?action=cron AND the ?action=alerts-* endpoints.
CRON_SECRET=
# Email delivery (Resend). No key -> alerts compute + return a would_send stub.
RESEND_API_KEY=
ALERT_EMAIL=anchit.tandon@vahdam.com            # recipient (default shown)
ALERT_FROM=VAHDAM Lifecycle OS <alerts@vahdamteas.com>   # verified Resend sender
# Anomaly detection runs NOW on the real monthly market export (no feed needed).
# Pulses + the EOD forecast need a LIVE INTRADAY feed (Shopify/Klaviyo orders,
# blocker B3): until this flag is "1" they return {skipped:true} and send nothing.
INTRADAY_FEED_READY=

# ── Vahdam3DConnectorEngine — dual-data resolution + brand cloning ──
# Shopify Storefront API (optional). When set, the engine reads catalog/pricing
# via authenticated GraphQL; when ABSENT it degrades to the PUBLIC /products.json
# scrape (the only mode authorized in this repo — Admin connector is not used).
VITE_SHOPIFY_STOREFRONT_TOKEN=        # marketing_automation Vite app (client-exposed, storefront scope only)
SHOPIFY_STOREFRONT_TOKEN=             # server-side equivalent, if ever needed

# ── Shopify Admin API — LIVE, READ-ONLY store data (api/_shared/shopify-core.js)
# Powers /api/shopify (op=shop|orders|products|customers|inventory|summary) and
# the Shopify row on /api/connectors-health. Read-only three ways over: only GET
# is permitted to Shopify hosts (read-only-egress.js), no mutating op exists in
# the core, and the token itself should be read-scoped. Unset -> every op returns
# a { connected:false, would_request } envelope; no store figure is invented.
# Requires LIVE_CONNECTORS=on as well, like every other outbound connector.
SHOPIFY_STORE_DOMAIN=                 # e.g. vahdam.myshopify.com (+ optional _US / _UK / _IN)
SHOPIFY_ADMIN_TOKEN=                  # read_orders, read_products, read_customers, read_inventory
SHOPIFY_API_VERSION=2026-04           # optional; defaults to this

# ── LIVE PRODUCT CATALOG (catalog-live.js + catalog-gate.js) ────────────────
# THE catalog for every surface. Resolution order, per market:
#   1. Shopify Admin products.json  (needs SHOPIFY_ADMIN_TOKEN above + LIVE_CONNECTORS=on)
#   2. the store's public /products.json  (no credential; needs only LIVE_CONNECTORS=on)
#   3. data/catalog/products_<region>.json — the build artifact, returned
#      labelled live:false + stale:true. Read-only surfaces may render it.
#      CREATIVE MAY NOT: catalog-gate.js blocks mailer / ad / landing-page /
#      social generation unless the catalog came from 1 or 2, because a creative
#      built on a stale catalog states prices and stock the store does not back.
# Inspect and force a refresh at /api/catalog?op=status|products|refresh|verify.
# That route is anonymous (the pages need it) but projects out Admin-only fields
# (inventory counts, SKUs, the variant list); op=refresh and fresh=1 walk the
# Admin API on demand and so need an operator (CRON_SECRET or an allowed Supabase
# session), as does /api/shopify in full.
SHOPIFY_STOREFRONT_BASE_US=           # optional per-market override of the verified store URL
SHOPIFY_STOREFRONT_BASE_UK=           # (…_IN, _EU, _AU, _ME, _GLOBAL likewise)
CATALOG_TTL_SECONDS=300               # optional; how long a live read is reused before re-fetching
CATALOG_MISS_TTL_SECONDS=60           # optional; how long a FAILED read is remembered, so a broken
                                      # store is not re-walked on every single request
CATALOG_MAX_AGE_MINUTES=60            # optional; a live read older than this blocks the gate as stale
CATALOG_GATE=                         # LEAVE UNSET. 'off' lets creative generate against a NON-LIVE
                                      # catalog for local work: it never fakes a pass — every artifact
                                      # is stamped gate_bypassed + DATA REQUIRED, and
                                      # /api/connectors-health reports the bypass as a live defect.

# ── Competitive benchmarking from the same platforms ────────────────────────
# /api/competitor?action=benchmark&brand=&domain= compares our connected
# platforms against a competitor. The competitor side uses PUBLIC sources only
# (their /products.json, Meta Ad Library, Google/TikTok transparency deep links)
# and needs no credentials — it works today. APIFY_TOKEN (free tier) upgrades the
# Ad Library pull from a deep link to structured creatives.
# Our ad/ESP credentials report on OUR accounts only, so competitor spend, CTR,
# CPM, ROAS and open rate are reported as null under own_only, never estimated.

# Snowflake → Supabase daily mirror (see api/_shared/snowflake-sync-core.js).
# The engine never queries Snowflake from the browser; a daily server job pulls
# into Supabase and the engine reads the mirror. Until these are set the sync
# endpoint returns a typed { connected:false, wouldRequest } stub.
SNOWFLAKE_ACCOUNT=                    # e.g. ab12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PAT=                        # Programmatic Access Token (preferred over password) for the SQL REST API
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=
SNOWFLAKE_SYNC_QUERY=                 # optional override SQL; defaults to the packaged daily metrics query
# Ads Analysis from Snowflake (api/_shared/ads-snowflake-core.js — READ ONLY).
# Live Meta/Google/TikTok ad data for the Costco + Target US accounts, powering
# the cohort/segmentation dashboard. Override each table if the FQN differs
# (DB.SCHEMA.TABLE, or SCHEMA.TABLE which is prefixed with SNOWFLAKE_DATABASE):
# Verified against the live warehouse (DATON + VAHDAM_DB). TikTok reports are
# per level; Meta/TikTok expose dedicated demographic/geo breakdown tables.
SF_TIKTOK_ADS_TABLE=DATON.RAW.TIKTOK_ADS_USA_CAMPAIGN_REPORT_DAILY
SF_TIKTOK_CAMPAIGN_TABLE=DATON.RAW.TIKTOK_ADS_USA_CAMPAIGN_REPORT_DAILY
SF_TIKTOK_ADGROUP_TABLE=DATON.RAW.TIKTOK_ADS_USA_ADGROUP_REPORT_DAILY
SF_TIKTOK_AD_TABLE=DATON.RAW.TIKTOK_ADS_USA_AD_REPORT_DAILY
SF_TIKTOK_AGE_GENDER_TABLE=DATON.RAW.TIKTOK_ADS_USA_CAMPAIGN_REPORT_DAILY_AGE_GENDER
SF_TIKTOK_COUNTRY_TABLE=DATON.RAW.TIKTOK_ADS_USA_CAMPAIGN_REPORT_DAILY_COUNTRY
SF_META_ADS_TABLE=VAHDAM_DB.MAPLEMONK.META_USA_ADS_INSIGHTS
SF_META_AGE_GENDER_TABLE=VAHDAM_DB.MAPLEMONK1.META_USA_ADS_INSIGHTS_AGE_AND_GENDER
SF_META_DEVICE_TABLE=VAHDAM_DB.MAPLEMONK1.META_USA_ADS_INSIGHTS_PLATFORM_AND_DEVICE
SF_META_CREATIVES_TABLE=VAHDAM_DB.MAPLEMONK1.META_USA_AD_CREATIVES
SF_GOOGLE_ADS_TABLE=VAHDAM_DB.MAPLEMONK.GOOGLE_ADS_USA
# Editable daily budget caps (USD) — reference/alerting only; never pushed to platforms.
ADS_BUDGET_TARGET_DAILY=1000
ADS_BUDGET_COSTCO_DAILY=300
