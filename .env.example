# ════════════════════════════════════════════════════════════════════════════
# VAHDAM Mailer Studio — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
# Copy to `.env.local` for local `vercel dev` use, OR add in Vercel dashboard
# under Settings → Environment Variables for Production / Preview / Development.
#
# NEVER commit a populated `.env.local` — it's already in `.gitignore`.
# This `.env.example` IS committed (no real values, just placeholders).
#
# TEXT PROVIDER CASCADE (tier-ordered, see api/_shared/llm.js):
#   Anthropic → OpenAI → Gemini → Grok/xAI → Groq → Cerebras
# Configure as many as you have — the cascade skips missing keys.
# ════════════════════════════════════════════════════════════════════════════

# ─── MODEL TIER DIAL (premium / standard / fast) ──────────────────────────
# Per-call `tier` (or APP_AI_TIER default) picks the model chain:
#   premium  (legacy 'maxpower') = *_TEXT_MODEL_MAX  — hero copy, mailer_full,
#            ChaiGPT, smart-brain copy. Chain: claude-opus-4-8 → gpt-5.5 →
#            gemini-3.1-pro → grok-4.3 → free floor.
#            Also puts OpenAI gpt-image-2 FIRST in the image cascade.
#   standard (legacy 'budget', DEFAULT) = *_TEXT_MODEL — variants, briefs,
#            calendars. Chain: claude-sonnet-5 → gpt-5-mini → gemini-3.5-flash
#            → grok-4.1-fast → free floor.
#   fast     (new) = *_TEXT_MODEL_FAST — classification, tagging, scoring.
#            Chain: claude-haiku-4-5 → gpt-5-nano → gemini-2.5-flash (free)
#            → groq → cerebras (Grok skipped).
APP_AI_TIER=standard

# ─── OpenAI / ChatGPT (paid) ──────────────────────────────────────────────
# Get key:  https://platform.openai.com/api-keys
# Fund:     https://platform.openai.com/settings/organization/billing ($5 min)
# Rotate if quota hits → add OPENAI_API_KEY_2 and OPENAI_API_KEY_3 as backups
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TEXT_MODEL_MAX=gpt-5.5
OPENAI_TEXT_MODEL_FAST=gpt-5-nano
# Image model: gpt-image-2 is the default primary (best instruction-following).
# If your account/org doesn't have it yet, the cascade auto-demotes to
# gpt-image-1 on model-not-found — no need to change this unless you want to
# pin gpt-image-1 explicitly. Requires a verified org + image credits.
OPENAI_IMAGE_MODEL=gpt-image-2

# ─── Anthropic / Claude (paid) ────────────────────────────────────────────
# Get key:  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_MODEL_MAX=claude-opus-4-8
ANTHROPIC_TEXT_MODEL_FAST=claude-haiku-4-5

# ─── Google Gemini (FREE tier available) ──────────────────────────────────
# Get key:  https://aistudio.google.com/app/apikey (free, sign in with Google)
# Free floor: gemini-2.5-flash (fast tier). Video: the same key drives Veo 3.1
# (paid tier required for video + Imagen).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL_MAX=gemini-3.1-pro
GEMINI_TEXT_MODEL_FAST=gemini-2.5-flash

# ─── Grok / xAI ───────────────────────────────────────────────────────────
# Get key:  https://console.x.ai
XAI_API_KEY=
GROK_TEXT_MODEL=grok-4.1-fast
GROK_TEXT_MODEL_MAX=grok-4.3

# ─── Groq (FREE — 30 RPM, OpenAI-compatible) ──────────────────────────────
# Get key:  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ─── Cerebras (FREE — 30 RPM, ultra-fast, OpenAI-compatible) ──────────────
# Get key:  https://cloud.cerebras.ai
# Note: free tier caps output at 8K tokens; no response_format support.
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b

# ─── VIDEO generation (api/_shared/video-core.js — all optional) ──────────
# Cascade: Veo 3.1 (GEMINI_API_KEY, paid tier) → Sora 2 (OPENAI_API_KEY;
# OpenAI video API sunsets 2026-09-24) → Higgsfield Cloud (~$0.10/s) →
# Runway gen4_turbo (~$0.05/s). With NO keys, ?action=video-generate returns a
# { connected:false, would_request } stub (same pattern as Klaviyo).
HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=
RUNWAY_API_KEY=

# ─── OPTIONAL — Ideogram 3 (text-in-image banners; not wired by default) ──
# IDEOGRAM_API_KEY=

# ─── OPTIONAL — Klaviyo (lifecycle email/SMS — scaffolded until key set) ──
# KLAVIYO_API_KEY=
# KLAVIYO_PUBLIC_KEY=
# KLAVIYO_REVISION=

# ─── OPTIONAL — Supabase (cross-device dashboard storage) ─────────────────
# If unset, dashboard falls back to localStorage-only.
# Get from: https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Google Sheets auth — TWO modes (pick ONE) ───────────────────────────
#
# MODE A (PREFERRED — keyless, can't be "rotated to death"):
# Workload Identity Federation. Vercel mints a short-lived OIDC token per
# request; Google STS swaps it for a federated access token; we impersonate
# the SA via IAM Credentials. No key file anywhere. Full setup in
# docs/workload-identity-federation.md.
#
# Required:
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/vercel-pool/providers/vercel-provider
GCP_SERVICE_ACCOUNT_EMAIL=lifecycle-os-bot@vahdam-lifecycle-os.iam.gserviceaccount.com
# Also REQUIRED: enable "OIDC Tokens" in Vercel Project Settings → Environment
# Variables → OIDC Tokens. That injects VERCEL_OIDC_TOKEN automatically — do
# NOT set it manually here.

# MODE B (LEGACY — JSON key in env, what we used before WIF):
# Use only if WIF isn't set up yet. The code prefers Mode A when GCP_*
# vars are present, so it's safe to leave both populated during cutover.
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=hub-bot@vahdam-lifecycle-os.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Sheet target (used by BOTH modes)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Emails

# ─── INTERNAL — set by Vercel automatically; do NOT override ──────────────
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=...
# VERCEL_OIDC_TOKEN=...   (injected per-request when OIDC Tokens is enabled)
