{
  "name": "vahdam-lifecycle-os",
  "version": "1.0.0",
  "private": true,
  "description": "VAHDAM Lifecycle OS — Data Analysis + 30-day Marketing Calendar + Mailer Creator. Forked from marketing_mailers__html_architect; adds retention dashboard + calendar generator on top of the existing 6-LLM mailer pipeline.",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "build": "node scripts/build-catalog.js",
    "dev": "node -e \"require('http').createServer().listen(3001)\"",
    "export:complete": "node scripts/export-complete.js",
    "deploy": "vercel --prod",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install",
    "subscribe": "node workers/auto-subscribe.js",
    "collect:ads": "node workers/collect-ads.js",
    "collect:landing": "node workers/collect-landing.js",
    "collect:wayback": "node workers/collect-wayback.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "google-auth-library": "^10.7.0",
    "googleapis": "^144.0.0",
    "imapflow": "^1.4.2",
    "mailparser": "^3.7.1",
    "xlsx-js-style": "^1.2.0"
  }
}
